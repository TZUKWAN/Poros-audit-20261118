# Offline bridge layer for an installed DSH image; the normal clean build is Dockerfile.dsh.
ARG POROS_DSH_BASE_IMAGE=poros/dsh:0.2.2-rc.1
FROM ${POROS_DSH_BASE_IMAGE}
COPY scripts/poros-dsh-bootstrap.mjs /opt/poros/bootstrap.mjs
COPY scripts/poros-bridge.mjs /opt/poros/poros-bridge.mjs
COPY scripts/poros-tool-policy.mjs /opt/poros/tool-policy.mjs
COPY scripts/poros-test-model.mjs /opt/poros/poros-test-model.mjs
RUN node -e "if(process.version !== 'v24.22.3') throw new Error('Cached image must use Node 24.22.3');" \
 && test "$(dsh --version)" = "0.2.2-rc.1"
LABEL org.poros.bridge-protocol="3"
