# Poros 专属环境（严禁填入宿主 DSH 的任何凭证/路径）
# 复制为 .env 后填写；.env 永不入库（.gitignore 已含）。

# 数据库（compose db 服务）
POROS_DB_PASSWORD=change-me-strong-password
DATABASE_URL="postgresql://poros:change-me-strong-password@127.0.0.1:55432/poros?schema=public"

# SeaweedFS S3（Compose s3 服务，显式认证、默认拒绝匿名）
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=poros-artifacts
S3_ACCESS_KEY=poros
S3_SECRET_KEY=poros

# 会话签名（生产用强随机）
JWT_SECRET=change-me-strong-random

# 模型网关：mock（默认，UI 标注"未配置真实服务"）| deepseek（需下方真实密钥）
MODEL_GATEWAY=mock
# POROS_DEEPSEEK_API_KEY=  # 仅生产授权后填写；禁止用未授权公共免费网关

# Kdocs / IMA / TinyFish：当前未实现/未配置，UI 如实标注
# 未实现的连接器不能靠配置开关标为可用

# API / worker / isolated DSH
PORT=8787
POROS_RUNTIME=gateway
POROS_DSH_MODEL_STUB=0
POROS_DSH_IMAGE=poros/dsh:0.2.2-rc.1-audit
POROS_MAX_CONCURRENCY=4
POROS_ORG_CONCURRENCY=2
