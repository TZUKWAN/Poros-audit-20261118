{
  "name": "poros",
  "version": "1.0.0",
  "description": "Poros Enterprise — agent development, configuration, collaboration and governance platform on a dedicated isolated DSH runtime.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run tests/api && npm run test:isolation",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "coverage": "vitest run --coverage",
    "prepare": "husky",
		"postinstall": "prisma generate",
    "db:up": "docker compose -f deploy/docker-compose.yml up -d db s3",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx src/server/seed.ts",
    "start": "tsx src/server/index.ts",
    "test:api": "vitest run tests/api",
    "test:isolation": "node tests/isolation/iso-01-sentinel.mjs && node tests/isolation/iso-02-compose-audit.mjs && node tests/isolation/iso-05-container-escape.mjs",
    "e2e": "node tests/e2e/run-e2e.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED（迁移中：原仓库无 LICENSE 文件，PRD §1.1 已记录，待权利人来信确定后再分发）",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.856.0",
    "@fastify/sse": "0.2.0",
    "@fastify/static": "8.2.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "fastify": "5.6.0",
    "jsonwebtoken": "9.0.2",
    "pino": "9.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "madge": "^8.0.0",
    "prettier": "3.9.10",
    "prisma": "6.19.0",
    "tsx": "4.21.0",
    "typescript": "5.9",
    "typescript-eslint": "8.71.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "undici": "8.12.2"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
